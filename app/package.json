{
  "name": "cpp-lab-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "cpp-lab \u2014 installable PWA that delivers the C++ curriculum one day at a time.",
  "scripts": {
    "dev": "vite",
    "build": "npm run content && vite build",
    "preview": "vite preview --host",
    "content": "node scripts/build-content.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node scripts/test-streak.mjs && node scripts/test-merge.mjs && node scripts/test-markdown.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.4",
    "sharp": "^0.35.4",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "yaml": "^2.8.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true
  }
}
