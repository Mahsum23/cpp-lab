# binaries, at the repo root where the compile commands drop them. Anchored with a
# leading slash on purpose: a bare `day[0-9]*` also matched the go/day01/ work
# directories, so every Go task file was silently unstageable.
/server
/client
/day[0-9]*
*.o
*.out
a.out

# build dirs (phase 3)
build/
cmake-build-*/

# ./lab's idea of which day you are on — local, per-machine, not shared
.lab/

# editor
.vscode/
.idea/
*.swp

# app (node)
app/node_modules/
app/dist/
app/dev-dist/

# WSL artefact from copying files out of Windows
*:Zone.Identifier
